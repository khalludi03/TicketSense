{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@ticketsense/shared": ["../../packages/shared/src"]
    },
    "noEmit": true
  },
  "include": ["src/**/*"]
}
